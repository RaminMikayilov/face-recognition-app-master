# Firebase configuration. Fill these in with values from your Firebase project
# console (Project settings -> General -> Your apps -> SDK setup).
# If VITE_FIREBASE_API_KEY and VITE_FIREBASE_PROJECT_ID are both set, the app
# will use Cloud Firestore as the primary profile store (with localStorage
# as an offline cache). Otherwise it falls back to localStorage only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Name of the registered user who gets the admin role (must match exactly)
VITE_ADMIN_NAME=
